# Ensure all text files use LF line endings in the repo
* text=auto eol=lf

# Windows batch files keep CRLF endings
*.bat text eol=crlf

# Shell scripts always LF
*.sh text eol=lf

# TypeScript / JavaScript / JSON / Config files LF
*.ts  text eol=lf
*.tsx text eol=lf
*.js  text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files (no conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
